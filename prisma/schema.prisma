generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id               String            @id @default(uuid())
  name             String
  vatNumber        String?
  address          String?
  phone            String?
  email            String?
  logoUrl          String?
  jasminApiKey     String?
  jasminAppId      String?
  jasminSecret     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  patients         Patient[]
  consultations    Consultation[]
  appointments     Appointment[]
  invoices         Invoice[]
  products         Product[]
  hospitalizations Hospitalization[]
}

model User {
  id                  String                @id @default(uuid())
  name                String
  email               String                @unique
  password            String
  role                Role                  @default(VETERINARIAN)
  clinicId            String
  clinic              Clinic                @relation(fields: [clinicId], references: [id])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  consultations       Consultation[]
  completedTasks      HospitalizationTask[]
  hospitalAdmission   Hospitalization[]     @relation("AdmissionBy")
}

enum Role {
  ADMIN
  VETERINARIAN
  ASSISTANT
  RECEPTIONIST
}

model Patient {
  id               String            @id @default(uuid())
  name             String
  species          String
  breed            String?
  gender           String?
  birthDate        DateTime?
  microchip        String?           @unique
  clinicId         String
  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  ownerId          String
  owner            Owner             @relation(fields: [ownerId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  consultations    Consultation[]
  appointments     Appointment[]
  labResults       LabResult[]
  imagingStudies   ImagingStudy[]
  hospitalizations Hospitalization[]
}

model Owner {
  id        String    @id @default(uuid())
  name      String
  email     String?   @unique
  phone     String?
  vatNumber String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  patients  Patient[]
}

model Consultation {
  id             String             @id @default(uuid())
  clinicId       String
  clinic         Clinic             @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  veterinarianId String
  veterinarian   User               @relation(fields: [veterinarianId], references: [id])
  date           DateTime           @default(now())
  status         ConsultationStatus @default(IN_PROGRESS)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  notes       ClinicalNote?
  attachments Attachment[]
  invoice     Invoice?
  appointment Appointment?
}

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Appointment {
  id             String             @id @default(uuid())
  clinicId       String
  clinic         Clinic             @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  veterinarianId String
  startTime      DateTime
  endTime        DateTime
  type           String? // e.g., "Check-up", "Surgery"
  status         ConsultationStatus @default(SCHEDULED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  consultationId String?       @unique
}

model ClinicalNote {
  id             String       @id @default(uuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  subjective     String?      @db.Text
  objective      String?      @db.Text
  assessment     String?      @db.Text
  plan           String?      @db.Text
}

model Attachment {
  id             String         @id @default(uuid())
  consultationId String
  consultation   Consultation   @relation(fields: [consultationId], references: [id])
  fileUrl        String
  type           AttachmentType @default(IMAGE)
  createdAt      DateTime       @default(now())
}

enum AttachmentType {
  IMAGE
  PDF
  DICOM
}

model Invoice {
  id               String       @id @default(uuid())
  clinicId         String
  clinic           Clinic       @relation(fields: [clinicId], references: [id])
  consultationId   String?      @unique
  consultation     Consultation? @relation(fields: [consultationId], references: [id])
  jasminInvoiceId  String?      @unique
  total            Decimal      @db.Decimal(10, 2)
  vatTotal6        Decimal      @default(0) @db.Decimal(10, 2)
  vatTotal13       Decimal      @default(0) @db.Decimal(10, 2)
  vatTotal23       Decimal      @default(0) @db.Decimal(10, 2)
  paymentMethod    String? // MULTIBANCO, CASH, MBWAY
  status           String       @default("DRAFT")
  pdfUrl           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  items InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Int
  price       Decimal @db.Decimal(10, 2)
  vatRate     Int     @default(23)
}

model Product {
  id            String   @id @default(uuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  name          String
  price         Decimal  @db.Decimal(10, 2)
  vatRate       Int      @default(23)
  stockQuantity Int      @default(0)
  barcode       String?
  batchNumber   String?  // Added for medical traceability
  expiryDate    DateTime? // Added for medical traceability
  category      String?   // Medications, Consumables, Pet Food, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements    StockMovement[]
  invoiceItems InvoiceItem[]
}

model StockMovement {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  type      MovementType
  quantity  Int
  source    String? // e.g., "consultation_id"
  createdAt DateTime     @default(now())
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model LabResult {
  id            String   @id @default(uuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  source        String   @default("FUJI")
  dataJson      Json
  abnormalFlags Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model ImagingStudy {
  id           String   @id @default(uuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  dicomUrl     String
  metadataJson Json?
  createdAt    DateTime @default(now())
}

model Hospitalization {
  id            String    @id @default(uuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id])
  admissionDate DateTime  @default(now())
  dischargeDate DateTime?
  boxNumber     String?
  reason        String
  status        String    @default("ADMITTED") // ADMITTED, DISCHARGED
  admissionById String
  admissionBy   User      @relation("AdmissionBy", fields: [admissionById], references: [id])
  
  tasks         HospitalizationTask[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model HospitalizationTask {
  id                String          @id @default(uuid())
  hospitalizationId String
  hospitalization   Hospitalization @relation(fields: [hospitalizationId], references: [id])
  description       String
  scheduledTime     DateTime
  completedAt       DateTime?
  completedById     String?
  completedBy       User?           @relation(fields: [completedById], references: [id])
  status            String          @default("PENDING") // PENDING, COMPLETED, SKIPPED
  notes             String?
}
