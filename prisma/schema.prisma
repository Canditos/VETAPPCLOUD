generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id               String            @id @default(uuid())
  name             String
  vatNumber        String?
  address          String?
  phone            String?
  email            String?
  logoUrl          String?
  jasminApiKey     String?
  jasminAppId      String?
  jasminSecret     String?
  vendusApiKey     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  vendusToken      String?
  appointments     Appointment[]
  budgets          Budget[]
  consultations    Consultation[]
  healthPlans      HealthPlan[]
  hospitalizations Hospitalization[]
  imagingStudies   ImagingStudy[]
  invoices         Invoice[]
  labResults       LabResult[]
  owners           Owner[]
  patients         Patient[]
  payments         Payment[]
  prescriptions    Prescription[]
  products         Product[]
  portalTokens     OwnerPortalToken[]
  portalMessages   PortalMessage[]
  appointmentRequests PortalAppointmentRequest[]
  stockMovements   StockMovement[]
  subscriptions    Subscription[]
  users            User[]
  automationSettings AutomationSettings?
  notifications      Notification[]
  smsLogs            SmsLog[]
  privacyConsents    PrivacyConsent[]
  vitalSigns         VitalSign[]
  servicePacks       ServicePack[]

  @@index([name])
}

model User {
  id                String                @id @default(uuid())
  name              String
  email             String                @unique
  passwordHash      String
  licenseNumber     String?
  role              Role                  @default(VETERINARIAN)
  clinicId          String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  consultations     Consultation[]
  hospitalAdmission Hospitalization[]     @relation("AdmissionBy")
  completedTasks    HospitalizationTask[]
  prescriptions     Prescription[]
  vitalSigns        VitalSign[]
  clinic            Clinic                @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([email])
  @@index([role])
}

model Patient {
  id                 String            @id @default(uuid())
  name               String
  species            String
  breed              String?
  gender             String?
  birthDate          DateTime?
  weight             Decimal?          @db.Decimal(10, 2)
  microchip          String?           @unique
  reproductiveStatus String?
  aggressionLevel    String?
  coatColor          String?
  status             String            @default("ACTIVE")
  valueScore         Int?              @default(0)
  preferredVeterinarianId String?
  allergies          String?
  clinicId           String
  ownerId            String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  appointments       Appointment[]
  budgets            Budget[]
  consultations      Consultation[]
  dewormings         Deworming[]
  hospitalizations   Hospitalization[]
  imagingStudies     ImagingStudy[]
  labResults         LabResult[]
  clinic             Clinic            @relation(fields: [clinicId], references: [id])
  owner              Owner             @relation(fields: [ownerId], references: [id])
  prescriptions      Prescription[]
  subscriptions      Subscription[]
  vaccinations       Vaccination[]
  vitalSigns         VitalSign[]
  appointmentRequests PortalAppointmentRequest[]

  @@index([clinicId])
  @@index([ownerId])
  @@index([species])
  @@index([status])
  @@index([name])
  @@index([microchip])
}

model Owner {
  id            String         @id @default(uuid())
  name          String
  email         String?
  phone         String?
  lifetimeValue Decimal        @default(0) @db.Decimal(10, 2)
  vatNumber     String?
  address       String?
  notes         String?
  passwordHash  String?
  clinicId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  budgets       Budget[]
  invoices      Invoice[]
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  patients      Patient[]
  payments      Payment[]
  portalTokens  OwnerPortalToken[]
  appointmentRequests PortalAppointmentRequest[]
  portalMessages      PortalMessage[]
  privacyConsents     PrivacyConsent[]
  subscriptions       Subscription[]

  @@index([clinicId])
  @@index([email])
  @@index([phone])
}

model Consultation {
  id             String             @id @default(uuid())
  clinicId       String
  patientId      String
  veterinarianId String
  date           DateTime           @default(now())
  status         ConsultationStatus @default(IN_PROGRESS)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  appointment    Appointment?
  attachments    Attachment[]
  notes          ClinicalNote?
  clinic         Clinic             @relation(fields: [clinicId], references: [id])
  patient        Patient            @relation(fields: [patientId], references: [id])
  veterinarian   User               @relation(fields: [veterinarianId], references: [id])
  invoice        Invoice?

  @@index([clinicId])
  @@index([patientId])
  @@index([veterinarianId])
  @@index([date])
  @@index([status])
}

model Appointment {
  id             String             @id @default(uuid())
  clinicId       String
  patientId      String
  veterinarianId String
  startTime      DateTime
  endTime        DateTime
  type           String?
  upsellOffered  Boolean?           @default(false)
  upsellAccepted Boolean?           @default(false)
  expectedRevenue Decimal?          @db.Decimal(10, 2)
  reason         String?
  status         ConsultationStatus @default(SCHEDULED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  consultationId String?            @unique
  clinic         Clinic             @relation(fields: [clinicId], references: [id])
  consultation   Consultation?      @relation(fields: [consultationId], references: [id])
  patient        Patient            @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([veterinarianId])
  @@index([startTime])
  @@index([status])
}

model ClinicalNote {
  id             String       @id @default(uuid())
  consultationId String       @unique
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model Attachment {
  id             String         @id @default(uuid())
  consultationId String
  fileUrl        String
  type           AttachmentType @default(IMAGE)
  createdAt      DateTime       @default(now())
  consultation   Consultation   @relation(fields: [consultationId], references: [id])
}

model Invoice {
  id              String        @id @default(uuid())
  clinicId        String
  ownerId         String
  consultationId  String?       @unique
  jasminInvoiceId String?       @unique
  externalId      String?       @unique
  total           Decimal       @db.Decimal(10, 2)
  vatTotal6       Decimal       @default(0) @db.Decimal(10, 2)
  vatTotal13      Decimal       @default(0) @db.Decimal(10, 2)
  vatTotal23      Decimal       @default(0) @db.Decimal(10, 2)
  status          String        @default("DRAFT")
  pdfUrl          String?
  issuedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paymentMethod   String?
  vendusId        String?       @unique
  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  consultation    Consultation? @relation(fields: [consultationId], references: [id])
  owner           Owner         @relation(fields: [ownerId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]

  @@index([clinicId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id        String   @id @default(uuid())
  clinicId  String
  ownerId   String
  invoiceId String?
  amount    Decimal  @db.Decimal(10, 2)
  method    String
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  owner     Owner    @relation(fields: [ownerId], references: [id])
}

model Budget {
  id          String       @id @default(uuid())
  clinicId    String
  ownerId     String
  patientId   String?
  status      String       @default("DRAFT")
  totalAmount Decimal      @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  owner       Owner        @relation(fields: [ownerId], references: [id])
  patient     Patient?     @relation(fields: [patientId], references: [id])
  items       BudgetItem[]
}

model BudgetItem {
  id          String  @id @default(uuid())
  budgetId    String
  description String
  quantity    Int
  price       Decimal @db.Decimal(10, 2)
  budget      Budget  @relation(fields: [budgetId], references: [id])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int
  price       Decimal  @db.Decimal(10, 2)
  vatRate     Int      @default(23)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
}

model Product {
  id            String          @id @default(uuid())
  clinicId      String
  name          String
  price         Decimal         @db.Decimal(10, 2)
  vatRate       Int             @default(23)
  stockQuantity Int             @default(0)
  minStock      Int             @default(5)
  barcode       String?
  batchNumber   String?
  expiryDate    DateTime?
  category      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  invoiceItems  InvoiceItem[]
  clinic        Clinic          @relation(fields: [clinicId], references: [id])
  movements     StockMovement[]

  @@index([clinicId])
  @@index([category])
  @@index([barcode])
}

model StockMovement {
  id        String       @id @default(uuid())
  clinicId  String
  productId String
  type      MovementType
  quantity  Int
  source    String?
  createdAt DateTime     @default(now())
  clinic    Clinic       @relation(fields: [clinicId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])

  @@index([clinicId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model LabResult {
  id            String   @id @default(uuid())
  clinicId      String
  patientId     String
  source        String   @default("FUJI")
  dataJson      Json
  abnormalFlags Boolean  @default(false)
  createdAt     DateTime @default(now())
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  patient       Patient  @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([source])
}

model ImagingStudy {
  id           String   @id @default(uuid())
  clinicId     String
  patientId    String
  dicomUrl     String
  metadataJson Json?
  createdAt    DateTime @default(now())
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  patient      Patient  @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([createdAt])
}

model Hospitalization {
  id            String                @id @default(uuid())
  clinicId      String
  patientId     String
  admissionDate DateTime              @default(now())
  dischargeDate DateTime?
  boxNumber     String?
  reason        String
  status        String                @default("ADMITTED")
  admissionById String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  admissionBy   User                  @relation("AdmissionBy", fields: [admissionById], references: [id])
  clinic        Clinic                @relation(fields: [clinicId], references: [id])
  patient       Patient               @relation(fields: [patientId], references: [id])
  tasks         HospitalizationTask[]

  @@index([clinicId])
  @@index([patientId])
  @@index([status])
  @@index([admissionDate])
}

model HospitalizationTask {
  id                String          @id @default(uuid())
  hospitalizationId String
  description       String
  scheduledTime     DateTime
  completedAt       DateTime?
  completedById     String?
  status            String          @default("PENDING")
  notes             String?
  completedBy       User?           @relation(fields: [completedById], references: [id])
  hospitalization   Hospitalization @relation(fields: [hospitalizationId], references: [id])

  @@index([hospitalizationId])
  @@index([status])
  @@index([scheduledTime])
}

model OwnerPortalToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  ownerId   String
  clinicId  String
  expiresAt DateTime?
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  owner     Owner    @relation(fields: [ownerId], references: [id])
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@index([token])
  @@index([ownerId])
  @@index([clinicId, ownerId])
  @@index([expiresAt])
}

model RateLimitEntry {
  key         String   @id
  attempts    Int      @default(0)
  windowStart DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

model PortalAppointmentRequest {
  id        String   @id @default(uuid())
  ownerId   String
  clinicId  String
  patientId String
  reason    String
  preferred String?
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  owner     Owner    @relation(fields: [ownerId], references: [id])
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
  messages  PortalMessage[]

  @@index([clinicId, status])
}

model HealthPlan {
  id            String         @id @default(uuid())
  clinicId      String
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  billingCycle  String         @default("MONTHLY")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  subscriptions Subscription[]
}

model Subscription {
  id          String     @id @default(uuid())
  clinicId    String
  ownerId     String
  patientId   String
  planId      String
  status      String     @default("ACTIVE")
  startDate   DateTime   @default(now())
  nextBilling DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  clinic      Clinic     @relation(fields: [clinicId], references: [id])
  owner       Owner      @relation(fields: [ownerId], references: [id])
  patient     Patient    @relation(fields: [patientId], references: [id])
  plan        HealthPlan @relation(fields: [planId], references: [id])
}

model VitalSign {
  id                  String   @id @default(uuid())
  patientId           String
  clinicId            String
  weight              Decimal? @db.Decimal(10, 2)
  temperature         Decimal? @db.Decimal(4, 2)
  heartRate           Int?
  respiratoryRate     Int?
  painScale           Int?     // 0-10 numeric pain scale (0=no pain, 10=maximum pain)
  bodyConditionScore  Int?     // 1-9 BCS scale (1-3=underweight, 4-5=ideal, 6-9=overweight/obese)
  notes               String?
  date                DateTime @default(now())
  veterinarianId      String?
  patient             Patient  @relation(fields: [patientId], references: [id])
  clinic              Clinic   @relation(fields: [clinicId], references: [id])
  veterinarian        User?    @relation(fields: [veterinarianId], references: [id])

  @@index([patientId])
  @@index([clinicId])
}

model Vaccination {
  id          String    @id @default(uuid())
  patientId   String
  vaccineName String
  batchNumber String?
  appliedAt   DateTime  @default(now())
  expiresAt   DateTime?
  notes       String?
  patient     Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([appliedAt])
}

model Deworming {
  id          String    @id @default(uuid())
  patientId   String
  type        String
  productName String
  batchNumber String?
  appliedAt   DateTime  @default(now())
  expiresAt   DateTime?
  notes       String?
  patient     Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([appliedAt])
}

model Prescription {
  id             String             @id @default(uuid())
  clinicId       String
  patientId      String
  veterinarianId String
  consultationId String?
  date           DateTime           @default(now())
  validUntil     DateTime?
  status         String             @default("ACTIVE")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  clinic         Clinic             @relation(fields: [clinicId], references: [id])
  patient        Patient            @relation(fields: [patientId], references: [id])
  veterinarian   User               @relation(fields: [veterinarianId], references: [id])
  items          PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  notes          String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VETERINARIAN
  ASSISTANT
  RECEPTIONIST
}

enum ConsultationStatus {
  SCHEDULED
  PENDING_CONFIRMATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttachmentType {
  IMAGE
  PDF
  DICOM
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model AutomationSettings {
  id             String   @id @default(uuid())
  clinicId       String   @unique
  emailEnabled   Boolean  @default(true)
  smsEnabled     Boolean  @default(false)
  reminder24h    Boolean  @default(true)
  vaccineAlert   Boolean  @default(true)
  invoiceEmail   Boolean  @default(true)
  smsMarketing   Boolean  @default(false)
  rut240Ip       String?
  rut240Port     Int      @default(80)
  rut240User     String?
  rut240Password String?
  rut240Enabled  Boolean  @default(false)
  aiApiKey       String?
  aiBaseUrl      String?  @default("https://openrouter.ai/api/v1")
  aiModel        String?  @default("openai/gpt-4o-mini")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  clinic         Clinic   @relation(fields: [clinicId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  clinicId  String
  title     String
  message   String
  type      String   @default("INFO") // INFO, APPOINTMENT, URGENT, MESSAGE, SMS
  isRead    Boolean  @default(false)
  link      String?
  ownerId   String?
  requestId String?
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([isRead])
  @@index([ownerId])
}

model SmsLog {
  id        String   @id @default(uuid())
  clinicId  String
  phone     String
  message   String
  status    String   @default("PENDING") // PENDING, SENT, FAILED
  type      String   @default("MANUAL")  // MANUAL, REMINDER_24H, VACCINE_ALERT, MARKETING
  patientId String?
  ownerId   String?
  error     String?
  sentAt    DateTime?
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([type])
  @@index([createdAt])
}

model PortalMessage {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  
  senderId    String
  senderType  SenderType
  
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id])
  
  requestId String?
  request   PortalAppointmentRequest? @relation(fields: [requestId], references: [id])

  @@index([clinicId])
  @@index([ownerId])
}

enum SenderType {
  CLINIC
  TUTOR
}

model PrivacyConsent {
  id        String         @id @default(cuid())
  ownerId   String
  owner     Owner          @relation(fields: [ownerId], references: [id])
  clinicId  String
  clinic    Clinic         @relation(fields: [clinicId], references: [id])
  version   String         @default("v1")
  policyUrl String?        // link to full policy at time of acceptance
  ip        String?
  userAgent String?
  method    String         @default("portal")  // portal, email, presencial
  accepted  Boolean        @default(false)
  acceptedAt DateTime?
  createdAt DateTime        @default(now())

  @@index([clinicId])
  @@index([ownerId])
  @@index([ownerId, accepted])
}

model ServicePack {
  id        String   @id @default(uuid())
  clinicId  String
  name      String
  type      String   // SURGERY, VACCINE, CONSULTATION, CUSTOM
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     ServicePackItem[]
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([type])
}

model ServicePackItem {
  id          String      @id @default(uuid())
  packId      String
  description String
  quantity    Int         @default(1)
  unitPrice   Decimal     @db.Decimal(10, 2)
  vatRate     Int         @default(23)
  pack        ServicePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
}
